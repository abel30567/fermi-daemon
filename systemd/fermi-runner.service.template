# Cloud-box runner unit. Bake into the AMI at /etc/systemd/system/fermi-runner.service
# and `systemctl enable fermi-runner`. The provisioner's user-data writes
# /etc/fermi/box.env and starts this unit.
[Unit]
Description=Fermi cloud-box runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/fermi/box.env
Environment=RUNNER_SELF_SHUTDOWN=1
ExecStart=/usr/bin/node /opt/fermi/box-runner.mjs
Restart=on-failure
RestartSec=10
# If the runner gives up for good, take the machine down with it.
ExecStopPost=/bin/sh -c '[ "$SERVICE_RESULT" = success ] || shutdown -h +2'

[Install]
WantedBy=multi-user.target
