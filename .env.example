# Fermi daemon environment — copy to .env and fill in. NEVER commit .env.
FERMI_URL=                 # base URL of your Fermi Cloudflare Worker, e.g. https://<your-worker>.workers.dev
FERMI_BEARER_TOKEN=        # bearer token the daemon and bridges use to call the Worker's admin/task/outbox endpoints
WA_WEBHOOK_SECRET=         # shared secret the WhatsApp bridge signs its inbound webhooks with
WA_OWNER_NUMBERS=          # comma-separated E.164 digits whose WhatsApp "stop" may interrupt the running task; empty = nobody
DISCORD_BRIDGE_SECRET=     # shared secret the Discord bridge signs its inbound webhooks with
DISCORD_BOT_TOKEN=         # Discord bot token for the dc-bridge client
SLACK_BRIDGE_SECRET=       # shared secret the Slack bridge signs its inbound webhooks with
SLACK_BOT_TOKEN=           # Slack bot token (xoxb-) for sl-bridge + Worker send
SLACK_APP_TOKEN=           # Slack app-level token (xapp-, connections:write) for Socket Mode
TUNNEL_URL=                # cloudflared tunnel health URL for MacOSMCP, e.g. https://mac.example.com
NODE_BIN=                  # optional: node (>= 22) poll.sh runs bin/run-once.mjs with; default is `node` on PATH

# Microsoft Teams bridge (optional). See PORTING/README for the Power Automate flows.
TEAMS_WEBHOOK_SECRET=      # shared secret Teams' inbound Power Automate flow signs POSTs to /teams/webhook with
# Localhost port the warm worker serves /teams/webhook on (the tunnel's target); required with TEAMS_WEBHOOK_SECRET:
# WARM_TEAMS_PORT=
# NOTE: the outbound webhook URL is NOT stored here — it contains a signature and
# would break shell `source` (it has '&'). Put it in a separate file the daemon
# reads directly:  echo '<power-automate-webhook-url>' > teams-outbound.url  (git-ignored)

# Cloud-box runner (box-runner.mjs). These go in the box's /etc/fermi/box.env, not this .env.
# FERMI_ENVELOPE_KEY=        # hex, >= 32 bytes (openssl rand -hex 32); the HMAC key the fermi-mcp gateway signs tasks with
# FERMI_ENVELOPE_KEY_PREV=   # optional: the previous key, accepted during a rotation; drop it once in-flight tasks drain
# FERMI_ENVELOPE_ENFORCE=    # 1 = refuse unsigned tasks; unset = grace mode (accept with a warning), the default until the signer ships
# FERMI_ENVELOPE_TTL_MS=     # optional: nonce lifetime, default 300000 (5 min); clock skew tolerance FERMI_ENVELOPE_SKEW_MS, default 30000
# FERMI_ALLOW_UNSANDBOXED=   # 1 = run the agent without an OS sandbox when none is available (dev only; logs a WARNING banner)
