{
  "name": "api-429-after-send",
  "description": "The model API answers 429 right after the reply went out. The warm session re-drains and completes the task without sending it again.",
  "fixtures": { "bindings": [{ "channel": "sl", "sender_id": "U0EVALOWNER", "note": "owner" }] },
  "session": { "redrain": 1 },
  "inbound": { "channel": "sl", "sender": "U0EVALOWNER", "chat": "D0EVAL", "text": "What is the capital of France?" },
  "expect": [
    { "exactlyOnce": "channel_send" },
    { "outbox.count": { "eq": 1, "chat_id": "D0EVAL" } },
    { "task.status": "done" },
    { "order": ["channel_send", "task_complete"] }
  ],
  "fake": {
    "script": [
      { "tool": "task_claim", "args": { "limit": 1, "stale_minutes": 25 }, "onTurn": 1 },
      { "tool": "context_bootstrap", "args": { "channel": "${task.channel}", "chat_id": "${task.chat_id}" }, "onTurn": 1 },
      { "tool": "channel_send", "args": { "channel": "${task.channel}", "chat_id": "${task.chat_id}", "text": "Paris." }, "onTurn": 1 },
      {
        "apiError": { "status": 429, "text": "API Error: 429 {\"type\":\"rate_limit_error\",\"message\":\"Number of requests has exceeded your rate limit\"}" },
        "onTurn": 1
      },
      { "tool": "task_complete", "args": { "id": "${task.id}", "status": "done", "result": "answered (completed after a 429)" }, "onTurn": 2 },
      { "tool": "task_claim", "args": { "limit": 1, "stale_minutes": 25 }, "onTurn": 2 }
    ]
  }
}
