{
  "name": "flush-profile-before-complete-neg",
  "description": "Negative control for flush-profile-before-complete: The preference is acknowledged but never saved.",
  "expectOutcome": "fail",
  "fixtures": {
    "bindings": [
      {
        "channel": "sl",
        "sender_id": "U0EVALOWNER",
        "note": "owner"
      }
    ],
    "profile": {
      "agent": "Eval instance.",
      "user": "Name: Eval Owner. Prefers short answers."
    }
  },
  "inbound": {
    "channel": "sl",
    "sender": "U0EVALOWNER",
    "chat": "D0EVAL",
