{
  "name": "reply-dm-own-chat",
  "description": "A DM is answered with one reply to the task's own chat, then task_complete done.",
  "fixtures": {
    "bindings": [
      {
        "channel": "sl",
        "sender_id": "U0EVALOWNER",
        "note": "owner"
      }
    ]
  },
  "inbound": {
    "channel": "sl",
    "sender": "U0EVALOWNER",
    "chat": "D0EVAL",
    "text": "What is the capital of Italy?"
  },
  "expect": [
    {
      "order": [
        "task_claim",
        "context_bootstrap",
        "channel_send",
        "task_complete"
      ]
    },
    {
      "exactlyOnce": "channel_send"
    },
    {
      "argsMatch": {
        "tool": "channel_send",
        "every": true,
        "args": {
          "channel": "sl",
          "chat_id": "D0EVAL"
        }
      }
    },
    {
      "outbox.count": {
        "eq": 1,
        "chat_id": "D0EVAL"
      }
    },
    {
      "outbox.count": 1
    },
    {
      "task.status": "done"
    }
  ],
  "fake": {
    "script": [
      {
        "tool": "task_claim",
        "args": {
          "limit": 1,
          "stale_minutes": 25
        }
      },
      {
        "tool": "context_bootstrap",
        "args": {
          "channel": "${task.channel}",
          "chat_id": "${task.chat_id}"
        }
      },
      {
        "tool": "channel_send",
        "args": {
          "channel": "${task.channel}",
          "chat_id": "${task.chat_id}",
          "text": "Rome."
        }
      },
      {
        "tool": "task_complete",
        "args": {
          "id": "${task.id}",
          "status": "done",
          "result": "answered"
        }
      },
      {
        "tool": "task_claim",
        "args": {
          "limit": 1,
          "stale_minutes": 25
        }
      }
    ]
  }
}
