{
  "name": "slack-mrkdwn-group-table-neg",
  "description": "Negative control for slack-mrkdwn-group-table: The group reply has a # header and a pipe table.",
  "expectOutcome": "fail",
  "fixtures": {
    "bindings": [
      {
        "channel": "sl",
        "sender_id": "U0EVALOWNER",
        "note": "owner"
      },
      {
        "channel": "sl",
        "sender_id": "T0EVAL",
        "note": "workspace"
      }
    ]
  },
  "inbound": {
    "channel": "sl",
    "sender": "U0EVALFRIEND",
    "display_name": "Example Friend",
    "team": "T0EVAL",
    "chat": "C0EVAL",
    "text": "@Fermi can you lay out the three example shifts with their hours?"
  },
  "expect": [
    {
      "exactlyOnce": "channel_send"
    },
    {
      "argsMatch": {
        "tool": "channel_send",
        "every": true,
        "args": {
          "chat_id": "C0EVAL",
          "text": "/^(?![\\s\\S]*(^|\\n)[ \\t]*\\|)/"
        }
      }
    },
    {
      "argsMatch": {
        "tool": "channel_send",
        "every": true,
        "args": {
          "text": "/^(?![\\s\\S]*(^|\\n)[ \\t]*#{1,6}[ \\t])/"
        }
      }
    },
    {
      "task.status": "done"
    }
  ],
  "fake": {
    "script": [
      {
        "tool": "task_claim",
        "args": {
          "limit": 1,
          "stale_minutes": 25
        }
      },
      {
        "tool": "context_bootstrap",
        "args": {
          "channel": "${task.channel}",
          "chat_id": "${task.chat_id}"
        }
      },
      {
        "tool": "channel_send",
        "args": {
          "channel": "${task.channel}",
          "chat_id": "${task.chat_id}",
          "text": "# Shifts\n| Shift | Hours |\n|---|---|\n| Morning | 6am–2pm |\n| Evening | 2pm–10pm |\n| Night | 10pm–6am |"
        }
      },
      {
        "tool": "task_complete",
        "args": {
          "id": "${task.id}",
          "status": "done",
          "result": "listed shifts"
        }
      },
      {
        "tool": "task_claim",
        "args": {
          "limit": 1,
          "stale_minutes": 25
        }
      }
    ]
  }
}
