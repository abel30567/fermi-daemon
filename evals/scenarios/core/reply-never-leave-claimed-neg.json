{
  "name": "reply-never-leave-claimed-neg",
  "description": "Negative control for reply-never-leave-claimed: The drain replies and stops without task_complete, leaving the task claimed.",
  "expectOutcome": "fail",
  "fixtures": {
    "bindings": [
      {
        "channel": "sl",
        "sender_id": "U0EVALOWNER",
        "note": "owner"
      }
    ]
  },
  "inbound": {
    "channel": "sl",
    "sender": "U0EVALOWNER",
    "chat": "D0EVAL",
    "text": "Thanks, that's all for today."
  },
  "expect": [
    {
      "called": "task_complete"
    },
    {
      "argsMatch": {
        "tool": "task_complete",
        "args": {
          "id": "/.+/",
          "status": "done"
        }
      }
    },
    {
      "task.status": "done"
    }
  ],
  "fake": {
    "script": [
      {
        "tool": "task_claim",
        "args": {
          "limit": 1,
          "stale_minutes": 25
        }
      },
      {
        "tool": "context_bootstrap",
        "args": {
          "channel": "${task.channel}",
          "chat_id": "${task.chat_id}"
        }
      },
      {
        "tool": "channel_send",
        "args": {
          "channel": "${task.channel}",
          "chat_id": "${task.chat_id}",
          "text": "Anytime. Have a good evening."
        }
      }
    ]
  }
}
