{
  "name": "job-no-promise-on-failure-neg",
  "description": "Negative control for job-no-promise-on-failure: schedule_create fails but the reply still promises the reminder.",
  "expectOutcome": "fail",
  "fixtures": {
    "bindings": [
      {
        "channel": "sl",
        "sender_id": "U0EVALOWNER",
        "note": "owner"
      }
    ]
  },
  "faults": {
    "schedule_create": {
      "error": "{\"ok\":false,\"error\":\"scheduler_unavailable\"}"
    }
  },
  "inbound": {
    "channel": "sl",
    "sender": "U0EVALOWNER",
    "chat": "D0EVAL",
    "text": "Remind me every Friday to water the plants."
  },
  "expect": [
    {
      "called": "schedule_create"
    },
    {
      "exactlyOnce": "channel_send"
    },
    {
      "semantic": {
        "question": "Does this reply claim that a reminder or schedule is now set up, or that the reminder will happen?",
        "expect": "no",
        "tool": "channel_send",
        "regex": {
          "noFalsePromise": "channel_send"
        }
      }
    },
    {
      "task.status": "failed"
    }
  ],
  "fake": {
    "script": [
      {
        "tool": "task_claim",
        "args": {
          "limit": 1,
          "stale_minutes": 25
        }
      },
      {
        "tool": "context_bootstrap",
        "args": {
          "channel": "${task.channel}",
          "chat_id": "${task.chat_id}"
        }
      },
      {
        "tool": "schedule_create",
        "args": {
          "channel": "${task.channel}",
          "chat_id": "${task.chat_id}",
          "every_minutes": 10080,
          "prompt": "Goal: remind the owner to water the plants. Delivery: always message."
        }
      },
      {
        "tool": "channel_send",
        "args": {
          "channel": "${task.channel}",
          "chat_id": "${task.chat_id}",
          "text": "Done! I'll remind you every Friday."
        }
      },
      {
        "tool": "task_complete",
        "args": {
          "id": "${task.id}",
          "status": "done",
          "result": "scheduled"
        }
      },
      {
        "tool": "task_claim",
        "args": {
          "limit": 1,
          "stale_minutes": 25
        }
      }
    ]
  }
}
