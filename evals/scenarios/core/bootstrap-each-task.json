{
  "name": "bootstrap-each-task",
  "description": "Each claimed task gets its own context_bootstrap for its own chat.",
  "fixtures": {
    "bindings": [
      {
        "channel": "sl",
        "sender_id": "U0EVALOWNER",
        "note": "owner"
      }
    ],
    "tasks": [
      {
        "id": "eval-boot-1",
        "channel": "sl",
        "sender": "U0EVALOWNER",
        "chat_id": "D0EVALA",
        "payload": "What day comes after Monday?"
      }
    ]
  },
  "inbound": {
    "channel": "sl",
    "sender": "U0EVALOWNER",
    "chat": "D0EVAL",
    "text": "What month comes after March?"
  },
  "expect": [
    {
      "argsMatch": {
        "tool": "context_bootstrap",
        "args": {
          "chat_id": "D0EVALA"
        }
      }
    },
    {
      "argsMatch": {
        "tool": "context_bootstrap",
        "args": {
          "chat_id": "D0EVAL"
        }
      }
    },
    {
      "order": [
        "task_claim",
        "context_bootstrap",
        "channel_send",
        "task_complete",
        "task_claim",
        "context_bootstrap",
        "channel_send",
        "task_complete"
      ]
    },
    {
      "task.status": {
        "id": "eval-boot-1",
        "is": "done"
      }
    },
    {
      "task.status": "done"
    }
  ],
  "fake": {
    "script": [
      {
        "tool": "task_claim",
        "args": {
          "limit": 1,
          "stale_minutes": 25
        }
      },
      {
        "tool": "context_bootstrap",
        "args": {
          "channel": "${task.channel}",
          "chat_id": "${task.chat_id}"
        }
      },
      {
        "tool": "channel_send",
        "args": {
          "channel": "${task.channel}",
          "chat_id": "${task.chat_id}",
          "text": "Tuesday."
        }
      },
      {
        "tool": "task_complete",
        "args": {
          "id": "${task.id}",
          "status": "done",
          "result": "answered"
        }
      },
      {
        "tool": "task_claim",
        "args": {
          "limit": 1,
          "stale_minutes": 25
        }
      },
      {
        "tool": "context_bootstrap",
        "args": {
          "channel": "${task.channel}",
          "chat_id": "${task.chat_id}"
        }
      },
      {
        "tool": "channel_send",
        "args": {
          "channel": "${task.channel}",
          "chat_id": "${task.chat_id}",
          "text": "April."
        }
      },
      {
        "tool": "task_complete",
        "args": {
          "id": "${task.id}",
          "status": "done",
          "result": "answered"
        }
      },
      {
        "tool": "task_claim",
        "args": {
          "limit": 1,
          "stale_minutes": 25
        }
      }
    ]
  }
}
