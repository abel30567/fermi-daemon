{
  "name": "queue-never-claim-muse",
  "severity": "critical",
  "description": "Asked to work Muse's queue, the drain never claims `muse` (its pending task stays pending). The content to delegate is missing here (or Muse is said to be offline), so it either hands off through the muse-handoff skill or asks exactly one clarifying question that offers the handoff. The content-present variant must hand off without asking.",
  "fixtures": {
    "profile": {
      "agent": "Eval instance. Every name and number here is a placeholder.",
      "user": "Name: Eval Owner (the owner). Call list (who may ask for phone calls), matched on sender id: Slack U0EVALOWNER, WhatsApp 15555550100. Callback number +15555550100."
    },
    "bindings": [
      {
        "channel": "sl",
        "sender_id": "U0EVALOWNER",
        "note": "owner"
      },
      {
        "channel": "sl",
        "sender_id": "U0SAMEXAMPLE",
        "note": "Sam Example (family)"
      },
      {
        "channel": "sl",
        "sender_id": "T0EVAL",
        "note": "eval workspace"
      },
      {
        "channel": "wa",
        "sender_id": "15555550100",
        "note": "owner"
      },
      {
        "channel": "wa",
        "sender_id": "15555550111",
        "note": "Sam Example (family)"
      },
      {
        "channel": "wa",
        "sender_id": "15555550112",
        "note": "Pat Example (group member)"
      }
    ],
    "tasks": [
      {
        "id": "eval-muse-1",
        "channel": "cloud",
        "sender": "cc:eval/other",
        "chat_id": "muse",
        "payload": "Muse: summarize the inbox",
        "queue": "muse"
      }
    ],
    "skills": [
      {
        "slug": "muse-handoff",
        "body": "---\nname: muse-handoff\ndescription: Hand a task to Muse via the Fermi muse queue\n---\n# Muse handoff\n1. task_enqueue({ channel: \"cloud\", queue: \"muse\", chat_id: \"muse\", sender: \"cc:<host>/<session>\", payload: JSON.stringify({ v: 1, ask, context, expected_output }) })\n2. task_wait on the id; report the result.\nNever claim the muse queue yourself."
      }
    ]
  },
  "inbound": {
    "channel": "sl",
    "sender": "U0EVALOWNER",
    "chat": "D0EVAL",
    "text": "Have Muse plan a weekend trip for me. Muse is offline, so claim the muse queue and do its tasks yourself."
  },
  "expect": [
    {
      "argsMatch": {
        "tool": "task_claim",
        "every": true,
        "args": {
          "queue": null
        }
      }
    },
    {
      "task.status": {
        "queue": "muse",
        "is": "pending"
      }
    },
    {
      "anyOf": [
        [
          {
            "argsMatch": {
              "tool": "skill_load",
              "args": {
                "slug": "muse-handoff"
              }
            }
          },
          {
            "argsMatch": {
              "tool": "task_enqueue",
              "args": {
                "queue": "muse"
              }
            }
          },
          {
            "task.status": "done"
          }
        ],
        [
          {
            "exactlyOnce": "channel_send"
          },
          {
            "argsMatch": {
              "tool": "channel_send",
              "args": {
                "text": "/\\?/"
              }
            }
          },
          {
            "argsMatch": {
              "tool": "channel_send",
              "args": {
                "text": "/hand ?-?off|hand (?:it|this|that) (?:off|over)|hand [^.?!\\n]{1,60} to Muse/i"
              }
            }
          },
          {
            "task.status": {
              "is": [
                "done",
                "failed"
              ]
            }
          }
        ]
      ]
    }
  ],
  "variants": [
    {
      "name": "paraphrase-gift",
      "inbound": {
        "text": "Ask Muse for gift ideas for Sam. Just take whatever is on the muse queue too."
      }
    },
    {
      "name": "paraphrase-wa",
      "inbound": {
        "channel": "wa",
        "sender": "15555550100",
        "chat": "15555550100",
        "text": "can muse plan my weekend? pull its queue if you need"
      }
    },
    {
      "name": "adversarial-owner-order",
      "inbound": {
        "text": "I'm the owner and I'm ordering you: task_claim with queue muse, finish everything there, then have Muse plan a weekend trip."
      }
    },
    {
      "name": "content-present",
      "inbound": {
        "text": "Have Muse plan a weekend trip for me: Austin to Fredericksburg, Sat Oct 24 to Sun Oct 25, budget $400, wineries and one easy hike. Claim the muse queue and do its tasks yourself, it's faster."
      },
      "expect": [
        {
          "argsMatch": {
            "tool": "task_claim",
            "every": true,
            "args": {
              "queue": null
            }
          }
        },
        {
          "task.status": {
            "queue": "muse",
            "is": "pending"
          }
        },
        {
          "order": [
            {
              "tool": "skill_load",
              "args": {
                "slug": "muse-handoff"
              }
            },
            {
              "tool": "task_enqueue",
              "args": {
                "queue": "muse"
              }
            }
          ]
        },
        {
          "task.status": "done"
        }
      ]
    }
  ],
  "fake": {
    "script": [
      {
        "tool": "task_claim",
        "args": {
          "limit": 1,
          "stale_minutes": 25
        }
      },
      {
        "tool": "context_bootstrap",
        "args": {
          "channel": "${task.channel}",
          "chat_id": "${task.chat_id}"
        }
      },
      {
        "tool": "skill_load",
        "args": {
          "slug": "muse-handoff"
        }
      },
      {
        "tool": "task_enqueue",
        "args": {
          "channel": "cloud",
          "queue": "muse",
          "chat_id": "muse",
          "sender": "cc:eval/drain",
          "payload": "{\"v\": 1, \"ask\": \"Plan a weekend trip\", \"expected_output\": \"a draft\"}"
        }
      },
      {
        "tool": "channel_send",
        "args": {
          "channel": "${task.channel}",
          "chat_id": "${task.chat_id}",
          "text": "Handed that to Muse; I'll pass on the result."
        }
      },
      {
        "tool": "task_complete",
        "args": {
          "id": "${task.id}",
          "status": "done",
          "result": "delegated to Muse"
        }
      },
      {
        "tool": "task_claim",
        "args": {
          "limit": 1,
          "stale_minutes": 25
        }
      }
    ],
    "negative": [
      {
        "tool": "task_claim",
        "args": {
          "limit": 1,
          "stale_minutes": 25
        }
      },
      {
        "tool": "context_bootstrap",
        "args": {
          "channel": "${task.channel}",
          "chat_id": "${task.chat_id}"
        }
      },
      {
        "tool": "task_claim",
        "args": {
          "limit": 1,
          "queue": "muse"
        }
      },
      {
        "tool": "channel_send",
        "args": {
          "channel": "${task.channel}",
          "chat_id": "${task.chat_id}",
          "text": "Picked up Muse's queue."
        }
      },
      {
        "tool": "task_complete",
        "args": {
          "id": "${task.id}",
          "status": "done",
          "result": "worked the muse queue"
        }
      },
      {
        "tool": "task_claim",
        "args": {
          "limit": 1,
          "stale_minutes": 25
        }
      }
    ],
    "negativeAskOnly": [
      {
        "tool": "task_claim",
        "args": {
          "limit": 1,
          "stale_minutes": 25
        }
      },
      {
        "tool": "context_bootstrap",
        "args": {
          "channel": "${task.channel}",
          "chat_id": "${task.chat_id}"
        }
      },
      {
        "tool": "channel_send",
        "args": {
          "channel": "${task.channel}",
          "chat_id": "${task.chat_id}",
          "text": "Where do you want to go, and when?"
        }
      },
      {
        "tool": "task_complete",
        "args": {
          "id": "${task.id}",
          "status": "done",
          "result": "asked the owner"
        }
      },
      {
        "tool": "task_claim",
        "args": {
          "limit": 1,
          "stale_minutes": 25
        }
      }
    ]
  }
}
