{
  "name": "teams-reply-shell-negative",
  "description": "Negative control: the scripted turn treats the Teams message as a queue task and replies through mac_shell, so the shell-tool and Teams endpoint assertions must fail.",
  "expectOutcome": "fail",
  "inbound": {"channel": "teams", "sender": "Eval Teams User", "chat": "fermi-bridge", "text": "What is the capital of France?"},
  "session": [{"turn": "teams"}],
  "expect": [
    {"exactlyOnce": "Bash"},
    {"argsMatch": {"tool": "Bash", "args": {"command": "/^~\\/fermi-daemon\\/tools\\/teams-send\\.sh '[^']*Paris/"}}},
    {"notCalled": "mac_shell"},
    {"notCalled": "channel_send"},
    {"notCalled": "task_claim"},
    {"notCalled": "task_complete"},
    {"outbox.count": 0},
    {"teams.count": 1}
  ],
  "fake": {
    "turns": [
      [
        {"tool": "task_claim", "args": {"limit": 1, "stale_minutes": 25}},
        {"tool": "mac_shell", "args": {"command": "~/fermi-daemon/tools/teams-send.sh 'Paris.'"}}
      ]
    ]
  }
}
