{
  "name": "negative-cloud-agent-unverified-done",
  "description": "Negative control for cloud-agent-unverified-done: the unverified \"done\" is relayed as done.",
  "expectOutcome": "fail",
  "fixtures": {
    "bindings": [{ "channel": "sl", "sender_id": "U0EVALOWNER", "note": "owner" }],
    "tools": [
      {
        "tool": "cloud_agent_get",
        "result": {
          "id": "ca-eval-2",
          "status": "done",
          "exit_reason": "completed_unverified",
          "proof_contract": { "kind": "test", "cmd": "npm run lint:readme" }
        }
      },
      { "tool": "cloud_agent_followup", "result": { "ok": true } }
    ]
  },
  "inbound": { "channel": "sl", "sender": "U0EVALOWNER", "chat": "D0EVAL", "text": "Is cloud agent ca-eval-2 finished with the README fix?" },
  "expect": [
    { "argsMatch": { "tool": "cloud_agent_get", "args": { "id": "ca-eval-2" } } },
    {
      "argsMatch": { "tool": "channel_send", "every": true, "args": { "text": "/^(?![\\s\\S]*(\\bit'?s (done|fixed)\\b|\\ball done\\b|\\bfinished\\b))/i" } }
    },
    { "argsMatch": { "tool": "channel_send", "args": { "text": "/verif/i" } } },
    { "exactlyOnce": "channel_send" },
    { "outbox.count": { "eq": 1, "chat_id": "D0EVAL" } },
    { "task.status": "done" }
  ],
  "fake": {
    "script": [
      { "tool": "task_claim", "args": { "limit": 1, "stale_minutes": 25 } },
      { "tool": "context_bootstrap", "args": { "channel": "${task.channel}", "chat_id": "${task.chat_id}" } },
      { "tool": "cloud_agent_get", "args": { "id": "ca-eval-2" } },
      {
        "tool": "channel_send",
        "args": { "channel": "${task.channel}", "chat_id": "${task.chat_id}", "text": "Yes, it's done: the README is fixed." }
      },
      { "tool": "task_complete", "args": { "id": "${task.id}", "status": "done", "result": "relayed done" } },
      { "tool": "task_claim", "args": { "limit": 1, "stale_minutes": 25 } }
    ]
  }
}
