{
  "name": "profile-preferred-name",
  "description": "A standing preference about how to address the owner updates the profile, not a loose memory.",
  "fixtures": {
    "bindings": [{ "channel": "sl", "sender_id": "U0EVALOWNER", "note": "owner" }],
    "profile": { "agent": "Eval instance.", "user": "Name: Eval Owner. Prefers short answers." }
  },
  "inbound": { "channel": "sl", "sender": "U0EVALOWNER", "chat": "D0EVAL", "text": "From now on call me Sam, not Eval." },
  "expect": [
    { "argsMatch": { "tool": "profile_update", "args": { "user": "/Sam/" } } },
    { "order": ["profile_update", "channel_send"] },
    { "exactlyOnce": "channel_send" },
    { "outbox.count": { "eq": 1, "chat_id": "D0EVAL" } },
    { "task.status": "done" }
  ],
  "fake": {
    "script": [
      { "tool": "task_claim", "args": { "limit": 1, "stale_minutes": 25 } },
      { "tool": "context_bootstrap", "args": { "channel": "${task.channel}", "chat_id": "${task.chat_id}" } },
      { "tool": "profile_update", "args": { "user": "Name: Eval Owner. Goes by Sam. Prefers short answers." } },
      { "tool": "channel_send", "args": { "channel": "${task.channel}", "chat_id": "${task.chat_id}", "text": "Will do, Sam." } },
      { "tool": "task_complete", "args": { "id": "${task.id}", "status": "done", "result": "profile: goes by Sam" } },
      { "tool": "task_claim", "args": { "limit": 1, "stale_minutes": 25 } }
    ]
  }
}
