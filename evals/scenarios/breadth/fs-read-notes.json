{
  "name": "fs-read-notes",
  "description": "A question about a file's contents is answered by reading the file.",
  "fixtures": {
    "bindings": [{ "channel": "sl", "sender_id": "U0EVALOWNER", "note": "owner" }],
    "tools": [
      {
        "tool": "fs_read",
        "match": "todo\\.md",
        "result": { "path": "notes/todo.md", "content": "- renew passport (placeholder)\n- book a dentist cleaning\n" }
      }
    ]
  },
  "inbound": { "channel": "sl", "sender": "U0EVALOWNER", "chat": "D0EVAL", "text": "What's on my todo list in notes/todo.md?" },
  "expect": [
    { "argsMatch": { "tool": "fs_read", "args": { "path": "/todo\\.md$/" } } },
    { "order": ["fs_read", "channel_send"] },
    { "argsMatch": { "tool": "channel_send", "args": { "text": "/passport[\\s\\S]*dentist/" } } },
    { "exactlyOnce": "channel_send" },
    { "outbox.count": { "eq": 1, "chat_id": "D0EVAL" } },
    { "task.status": "done" }
  ],
  "fake": {
    "script": [
      { "tool": "task_claim", "args": { "limit": 1, "stale_minutes": 25 } },
      { "tool": "context_bootstrap", "args": { "channel": "${task.channel}", "chat_id": "${task.chat_id}" } },
      { "tool": "fs_read", "args": { "path": "notes/todo.md" } },
      {
        "tool": "channel_send",
        "args": { "channel": "${task.channel}", "chat_id": "${task.chat_id}", "text": "Your todo list: renew passport, book a dentist cleaning." }
      },
      { "tool": "task_complete", "args": { "id": "${task.id}", "status": "done", "result": "read notes/todo.md" } },
      { "tool": "task_claim", "args": { "limit": 1, "stale_minutes": 25 } }
    ]
  }
}
