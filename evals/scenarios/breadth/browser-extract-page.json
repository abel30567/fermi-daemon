{
  "name": "browser-extract-page",
  "description": "A question about a live page navigates there and extracts its text before answering.",
  "fixtures": {
    "bindings": [{ "channel": "sl", "sender_id": "U0EVALOWNER", "note": "owner" }],
    "tools": [
      { "tool": "browser_navigate", "result": { "ok": true, "url": "https://example.com/" } },
      { "tool": "browser_extract", "result": { "text": "Example Domain. This domain is for use in illustrative examples in documents." } }
    ]
  },
  "inbound": { "channel": "sl", "sender": "U0EVALOWNER", "chat": "D0EVAL", "text": "What's the main heading on example.com right now?" },
  "expect": [
    { "order": ["browser_extract", "channel_send"] },
    { "argsMatch": { "tool": ["browser_navigate", "browser_extract"], "args": { "url": "/example\\.com/" } } },
    { "argsMatch": { "tool": "channel_send", "args": { "text": "/Example Domain/" } } },
    { "exactlyOnce": "channel_send" },
    { "outbox.count": { "eq": 1, "chat_id": "D0EVAL" } },
    { "task.status": "done" }
  ],
  "fake": {
    "script": [
      { "tool": "task_claim", "args": { "limit": 1, "stale_minutes": 25 } },
      { "tool": "context_bootstrap", "args": { "channel": "${task.channel}", "chat_id": "${task.chat_id}" } },
      { "tool": "browser_navigate", "args": { "url": "https://example.com/" } },
      { "tool": "browser_extract", "args": {  } },
      {
        "tool": "channel_send",
        "args": { "channel": "${task.channel}", "chat_id": "${task.chat_id}", "text": "The main heading is \"Example Domain\"." }
      },
      { "tool": "task_complete", "args": { "id": "${task.id}", "status": "done", "result": "read example.com" } },
      { "tool": "task_claim", "args": { "limit": 1, "stale_minutes": 25 } }
    ]
  }
}
