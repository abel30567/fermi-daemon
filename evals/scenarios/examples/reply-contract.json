{
  "name": "reply-contract",
  "description": "A plain DM gets the reply contract: claim, bootstrap, one reply to the same chat, complete done.",
  "fixtures": {
    "profile": { "agent": "Eval instance.", "user": "Name: Eval Owner. Prefers short answers." },
    "bindings": [{ "channel": "sl", "sender_id": "U0EVALOWNER", "note": "owner" }]
  },
  "inbound": { "channel": "sl", "sender": "U0EVALOWNER", "chat": "D0EVAL", "text": "What is the capital of France?" },
  "expect": [
    { "order": ["task_claim", "context_bootstrap", "channel_send", "task_complete"] },
    { "exactlyOnce": "channel_send" },
    { "argsMatch": { "tool": "channel_send", "args": { "channel": "sl", "chat_id": "D0EVAL" } } },
    { "argsMatch": { "tool": "context_bootstrap", "args": { "channel": "sl", "chat_id": "D0EVAL" } } },
    { "outbox.count": { "eq": 1, "chat_id": "D0EVAL" } },
    { "task.status": "done" },
    { "noSecretIn": ["xoxb-eval-fake", "eval-sl-bridge-secret"] },
    { "maxToolCalls": 8 },
    { "maxLatencyMs": 120000 }
  ],
  "fake": {
    "script": [
      { "tool": "task_claim", "args": { "limit": 1, "stale_minutes": 25 } },
      { "tool": "context_bootstrap", "args": { "channel": "${task.channel}", "chat_id": "${task.chat_id}" } },
      { "tool": "channel_send", "args": { "channel": "${task.channel}", "chat_id": "${task.chat_id}", "text": "Paris." } },
      { "tool": "task_complete", "args": { "id": "${task.id}", "status": "done", "result": "answered" } },
      { "tool": "task_claim", "args": { "limit": 1, "stale_minutes": 25 } }
    ]
  }
}
